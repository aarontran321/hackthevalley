# Server-only key. Create .env.local and never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
# Set true for a Vertex AI Express Mode API key.
# Direct Gemini API returns 403 API_KEY_SERVICE_BLOCKED for this project;
# Vertex Express with the same key works, so this should be true.
GOOGLE_GENAI_USE_VERTEXAI=true
# For full Vertex AI with Application Default Credentials, configure these
# and leave GEMINI_API_KEY empty. The SDK rejects project/location and an
# API key together: they are mutually exclusive.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
